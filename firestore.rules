rules_version = '2';

// LinkBoard TBR — Firestore security rules.
//
// Principle: nobody gets ANY data unless they are signed in AND an admin has
// added them to the team (a document exists in /users/{their uid}).
// A Firebase account on its own (self sign-up through the API, any Google
// account via "Sign in with Google") gets nothing.
//
// Roles (users/{uid}.role): 'admin' | 'manager' | 'builder'.
// The server (/api, Firebase Admin SDK) bypasses these rules entirely.
//
// Deploy: Firebase Console → Firestore Database → Rules → paste → Publish.

service cloud.firestore {
  match /databases/{database}/documents {

    // ── helpers ──────────────────────────────────────────────
    function signedIn() { return request.auth != null; }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isMember() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function role() { return me().get('role', 'builder'); }
    function isAdmin() { return isMember() && role() == 'admin'; }
    function isStaff() { return isMember() && (role() == 'admin' || role() == 'manager'); }
    // Tatev has admin-style link tools in the app (Bulk Relevancy, Projects).
    function isLinkEditor() { return isStaff() || (isMember() && me().get('name', '') == 'Tatev'); }

    // A link belongs to the caller if its `builder` matches their team name
    // or email — the same loose (case/space-insensitive) match the app uses.
    function myName()   { return string(me().get('name', '')).lower().trim(); }
    function myEmail()  { return string(request.auth.token.get('email', '')).lower().trim(); }
    function myPrefix() { return myEmail().split('@')[0]; }
    function ownsLink(data) {
      let b = string(data.get('builder', '')).lower().trim();
      return b != '' && (
        b == myName() || b == myEmail() || b == myPrefix() ||
        (myName() == '' && myPrefix() != '' && b.matches(myPrefix() + '.*'))
      );
    }

    // ── team members & roles: only admins can add/remove/promote ──
    match /users/{uid} {
      allow read: if isMember();
      allow create, update, delete: if isAdmin();
    }

    // ── links ──────────────────────────────────────────────
    // Everyone on the team can read (duplicate checks, dashboards) and add.
    // Admin/manager (and Tatev) can change or delete any link; a builder only their own,
    // and can't reassign it to someone else.
    match /links/{id} {
      allow read, create: if isMember();
      allow update: if isLinkEditor() ||
        (isMember() && ownsLink(resource.data) &&
         request.resource.data.get('builder', '') == resource.data.get('builder', ''));
      allow delete: if isLinkEditor() || (isMember() && ownsLink(resource.data));
    }

    // ── projects: Tatev & others can add/edit; only admins delete ──
    match /projects/{id} {
      allow read, create, update: if isMember();
      allow delete: if isAdmin();
    }

    // ── admin-only settings pages (KPI, Load, Capacity, Quality reqs) ──
    match /kpi/{id}                 { allow read: if isMember(); allow write: if isAdmin(); }
    match /load/{id}                { allow read: if isMember(); allow write: if isAdmin(); }
    match /capacities/{id}          { allow read: if isMember(); allow write: if isAdmin(); }
    match /qualityRequirements/{id} { allow read: if isMember(); allow write: if isAdmin(); }

    // ── shared day-to-day work data: any team member ──
    match /requirements/{id}   { allow read, write: if isMember(); }
    match /domains/{id}        { allow read, write: if isMember(); }
    match /domainFolders/{id}  { allow read, write: if isMember(); }
    match /doubleCheckLog/{id} { allow read, create: if isMember(); }
    match /outreachHistory/{id}{ allow read, write: if isMember(); }
    match /outreachEmails/{id} { allow read, write: if isMember(); }
    match /notifications/{id}  { allow read, create, update: if isMember(); allow delete: if isAdmin(); }
    match /sessions/{id}       { allow read, create, update: if isMember(); }
    match /presence/{id}       { allow read, write: if isMember(); }
    match /linkProofs/{id}     { allow read, create, update: if isMember(); allow delete: if isLinkEditor(); }

    // ── written only by the server; team can read ──
    match /gmailConnections/{id} { allow read: if isMember(); }
    match /emailCounts/{id}      { allow read: if isMember(); }
    match /meta/{id}             { allow read: if isMember(); }

    // ── encrypted Gmail / Snov tokens: server only, never the browser ──
    match /gmailSecrets/{id} { allow read, write: if false; }
    match /snovSecrets/{id}  { allow read, write: if false; }
    // Outreach Agent rows — admin-only, read/written only through /api/outreach.
    match /outreachAgent/{id} { allow read, write: if false; }

    // Anything not listed above is closed.
  }
}
